{
  "name": "must-battery-mon",
  "version": "1.0.0",
  "description": "Reads a Must LP16-48100 battery BMS over RS232 (read-only) and publishes to MQTT / Home Assistant, with a small web dashboard.",
  "main": "server.js",
  "license": "ISC",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "probe": "node scripts/probe.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop must-battery",
    "pm2:restart": "pm2 restart must-battery",
    "pm2:logs": "pm2 logs must-battery",
    "pm2:status": "pm2 status"
  },
  "dependencies": {
    "@serialport/parser-readline": "^12.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "mqtt": "^5.14.1",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "pm2": "^5.3.0"
  }
}
