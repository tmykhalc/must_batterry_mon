# Battery adapter: ALWAYS the by-id path, never /dev/ttyUSBn (numbers can swap after a reboot).
SERIAL_PORT=/dev/serial/by-id/usb-Prolific_Technology_Inc._USB-Serial_Controller_DGDIb136G03-if00-port0
SERIAL_BAUD=9600
BMS_VER=25
BMS_ADDR=01
POLL_INTERVAL_MS=5000
ALARM_POLL_INTERVAL_MS=30000

MQTT_URL=mqtt://192.168.1.201
MQTT_PORT=1883
MQTT_USERNAME=ha
MQTT_PASSWORD=
MQTT_PREFIX=home/battery

HTTP_PORT=3001

# 1 = BMS reports charging as positive current; -1 = reverse it (see README).
CURRENT_SIGN=1
